@prefix : <http://example.org/smart-parking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/smart-parking> a owl:Ontology ;
    rdfs:comment "Smart Parking Access & Space Allocation, CT-351 KRR CCP. Generated by tools/build_all.py." .

# Object properties
:owns a owl:ObjectProperty ; rdfs:comment "Person → Vehicle (Horn predicate owns/2)" .
:hasPermit a owl:ObjectProperty ; rdfs:comment "Person → ParkingPermit (has_permit/2)" .
:locatedIn a owl:ObjectProperty ; rdfs:comment "ParkingSpace → ParkingZone (located_in/2)" .
:partOf a owl:ObjectProperty ; rdfs:comment "ParkingZone → ParkingFacility (part_of/2)" .
:madeBy a owl:ObjectProperty ; rdfs:comment "Reservation → Person (reserved_by/2)" .
:forSpace a owl:ObjectProperty ; rdfs:comment "Reservation → ParkingSpace (reserved_space/2)" .
:allocatedTo a owl:ObjectProperty ; rdfs:comment "ParkingSpace → Person (allocate/2 read right to left)" .
:locatedIn a owl:FunctionalProperty .

# Classes
:AccessibleSpace a owl:Class .
:AuthorizedDriver a owl:Class .
:AuthorizedEmployee a owl:Class .
:AuthorizedStudent a owl:Class .
:AuthorizedVisitor a owl:Class .
:BadgeHolder a owl:Class .
:Car a owl:Class .
:EVChargingSpace a owl:Class .
:ElectricCar a owl:Class .
:Employee a owl:Class .
:EmployeePermit a owl:Class .
:Faculty a owl:Class .
:Motorbike a owl:Class .
:MotorbikeSpace a owl:Class .
:NonBadgeHolder a owl:Class .
:ParkingFacility a owl:Class .
:ParkingPermit a owl:Class .
:ParkingSpace a owl:Class .
:ParkingZone a owl:Class .
:Person a owl:Class .
:Reservation a owl:Class .
:Staff a owl:Class .
:Student a owl:Class .
:StudentPermit a owl:Class .
:ValidPermit a owl:Class .
:ValidPermitHolder a owl:Class .
:Vehicle a owl:Class .
:Visitor a owl:Class .
:VisitorPass a owl:Class .

# Axioms
# T01: Student ⊑ Person
:Student rdfs:subClassOf :Person .
# T02: Employee ⊑ Person
:Employee rdfs:subClassOf :Person .
# T03: Faculty ⊑ Employee
:Faculty rdfs:subClassOf :Employee .
# T04: Staff ⊑ Employee
:Staff rdfs:subClassOf :Employee .
# T05: Visitor ⊑ Person
:Visitor rdfs:subClassOf :Person .
# T06: BadgeHolder ⊑ Person
:BadgeHolder rdfs:subClassOf :Person .
# T07: NonBadgeHolder ⊑ Person
:NonBadgeHolder rdfs:subClassOf :Person .
# T08: StudentPermit ⊑ ParkingPermit
:StudentPermit rdfs:subClassOf :ParkingPermit .
# T09: EmployeePermit ⊑ ParkingPermit
:EmployeePermit rdfs:subClassOf :ParkingPermit .
# T10: VisitorPass ⊑ ParkingPermit
:VisitorPass rdfs:subClassOf :ParkingPermit .
# T11: ValidPermit ⊑ ParkingPermit
:ValidPermit rdfs:subClassOf :ParkingPermit .
# T12: AccessibleSpace ⊑ ParkingSpace
:AccessibleSpace rdfs:subClassOf :ParkingSpace .
# T13: EVChargingSpace ⊑ ParkingSpace
:EVChargingSpace rdfs:subClassOf :ParkingSpace .
# T14: MotorbikeSpace ⊑ ParkingSpace
:MotorbikeSpace rdfs:subClassOf :ParkingSpace .
# T15: ParkingSpace ⊑ ∃locatedIn.ParkingZone
:ParkingSpace rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :locatedIn ; owl:someValuesFrom :ParkingZone ] .
# T16: ParkingZone ⊑ ∃partOf.ParkingFacility
:ParkingZone rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :partOf ; owl:someValuesFrom :ParkingFacility ] .
# T17: Reservation ⊑ ∃madeBy.Person ⊓ ∃forSpace.ParkingSpace
:Reservation rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty :madeBy ; owl:someValuesFrom :Person ] [ a owl:Restriction ; owl:onProperty :forSpace ; owl:someValuesFrom :ParkingSpace ] ) ] .
# T18: Vehicle ⊑ ∃owns⁻.Person
:Vehicle rdfs:subClassOf [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :owns ] ; owl:someValuesFrom :Person ] .
# T19: AccessibleSpace ⊑ ∀allocatedTo.BadgeHolder
:AccessibleSpace rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :allocatedTo ; owl:allValuesFrom :BadgeHolder ] .
# T20: MotorbikeSpace ⊑ ∀allocatedTo.∃owns.Motorbike
:MotorbikeSpace rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :allocatedTo ; owl:allValuesFrom [ a owl:Restriction ; owl:onProperty :owns ; owl:someValuesFrom :Motorbike ] ] .
# T21: Motorbike ⊑ Vehicle
:Motorbike rdfs:subClassOf :Vehicle .
# T22: ElectricCar ⊑ Vehicle
:ElectricCar rdfs:subClassOf :Vehicle .
# T23: Car ⊑ Vehicle
:Car rdfs:subClassOf :Vehicle .
# T24: ValidPermitHolder ≡ Person ⊓ ∃hasPermit.ValidPermit
:ValidPermitHolder owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Person [ a owl:Restriction ; owl:onProperty :hasPermit ; owl:someValuesFrom :ValidPermit ] ) ] .
# T25: AuthorizedStudent ≡ Student ⊓ ∃hasPermit.(ValidPermit ⊓ StudentPermit)
:AuthorizedStudent owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Student [ a owl:Restriction ; owl:onProperty :hasPermit ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :ValidPermit :StudentPermit ) ] ] ) ] .
# T26: AuthorizedEmployee ≡ Employee ⊓ ∃hasPermit.(ValidPermit ⊓ EmployeePermit)
:AuthorizedEmployee owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Employee [ a owl:Restriction ; owl:onProperty :hasPermit ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :ValidPermit :EmployeePermit ) ] ] ) ] .
# T27: AuthorizedVisitor ≡ Visitor ⊓ ∃hasPermit.(ValidPermit ⊓ VisitorPass)
:AuthorizedVisitor owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Visitor [ a owl:Restriction ; owl:onProperty :hasPermit ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :ValidPermit :VisitorPass ) ] ] ) ] .
# T28: AuthorizedDriver ≡ AuthorizedStudent ⊔ AuthorizedEmployee ⊔ AuthorizedVisitor
:AuthorizedDriver owl:equivalentClass [ a owl:Class ; owl:unionOf ( :AuthorizedStudent :AuthorizedEmployee :AuthorizedVisitor ) ] .
# D01: Student ⊓ Employee ⊑ ⊥
:Student owl:disjointWith :Employee .
# D02: Student ⊓ Visitor ⊑ ⊥
:Student owl:disjointWith :Visitor .
# D03: Employee ⊓ Visitor ⊑ ⊥
:Employee owl:disjointWith :Visitor .
# D04: Faculty ⊓ Staff ⊑ ⊥
:Faculty owl:disjointWith :Staff .
# D05: BadgeHolder ⊓ NonBadgeHolder ⊑ ⊥
:BadgeHolder owl:disjointWith :NonBadgeHolder .
# D06: StudentPermit ⊓ EmployeePermit ⊑ ⊥
:StudentPermit owl:disjointWith :EmployeePermit .
# D07: StudentPermit ⊓ VisitorPass ⊑ ⊥
:StudentPermit owl:disjointWith :VisitorPass .
# D08: EmployeePermit ⊓ VisitorPass ⊑ ⊥
:EmployeePermit owl:disjointWith :VisitorPass .
# D09: AccessibleSpace ⊓ EVChargingSpace ⊑ ⊥
:AccessibleSpace owl:disjointWith :EVChargingSpace .
# D10: AccessibleSpace ⊓ MotorbikeSpace ⊑ ⊥
:AccessibleSpace owl:disjointWith :MotorbikeSpace .
# D11: EVChargingSpace ⊓ MotorbikeSpace ⊑ ⊥
:EVChargingSpace owl:disjointWith :MotorbikeSpace .
# D12: Motorbike ⊓ ElectricCar ⊑ ⊥
:Motorbike owl:disjointWith :ElectricCar .
# D13: Motorbike ⊓ Car ⊑ ⊥
:Motorbike owl:disjointWith :Car .
# D14: Car ⊓ ElectricCar ⊑ ⊥
:Car owl:disjointWith :ElectricCar .
# D15: Person ⊓ Vehicle ⊑ ⊥
:Person owl:disjointWith :Vehicle .
# D16: Person ⊓ ParkingSpace ⊑ ⊥
:Person owl:disjointWith :ParkingSpace .
# D17: ParkingSpace ⊓ ParkingZone ⊑ ⊥
:ParkingSpace owl:disjointWith :ParkingZone .

# Individuals
:ahmed a owl:NamedIndividual, :Faculty, :NonBadgeHolder .
:ali a owl:NamedIndividual, :NonBadgeHolder, :Student .
:bike_fatima a owl:NamedIndividual, :Motorbike, :Vehicle .
:bilal a owl:NamedIndividual, :NonBadgeHolder, :Visitor .
:car_ali a owl:NamedIndividual, :Car, :Vehicle .
:car_bilal a owl:NamedIndividual, :Car, :Vehicle .
:car_hina a owl:NamedIndividual, :Car, :Vehicle .
:car_sara a owl:NamedIndividual, :Car, :Vehicle .
:car_usman a owl:NamedIndividual, :Car, :Vehicle .
:car_zara a owl:NamedIndividual, :Car, :Vehicle .
:ev_ahmed a owl:NamedIndividual, :ElectricCar, :Vehicle .
:fatima a owl:NamedIndividual, :NonBadgeHolder, :Staff .
:hina a owl:NamedIndividual, :NonBadgeHolder, :Visitor .
:ned_lot a owl:NamedIndividual, :ParkingFacility .
:p_ahmed a owl:NamedIndividual, :EmployeePermit, :ParkingPermit .
:p_ali a owl:NamedIndividual, :ParkingPermit, :StudentPermit .
:p_fatima a owl:NamedIndividual, :EmployeePermit, :ParkingPermit .
:p_sara a owl:NamedIndividual, :ParkingPermit, :StudentPermit .
:p_usman a owl:NamedIndividual, :ParkingPermit, :StudentPermit .
:p_zara a owl:NamedIndividual, :ParkingPermit, :StudentPermit .
:r1 a owl:NamedIndividual, :Reservation .
:r2 a owl:NamedIndividual, :Reservation .
:s_a1 a owl:NamedIndividual, :ParkingSpace .
:s_a2 a owl:NamedIndividual, :ParkingSpace .
:s_a3 a owl:NamedIndividual, :AccessibleSpace, :ParkingSpace .
:s_a4 a owl:NamedIndividual, :MotorbikeSpace, :ParkingSpace .
:s_a5 a owl:NamedIndividual, :ParkingSpace .
:s_e1 a owl:NamedIndividual, :ParkingSpace .
:s_e2 a owl:NamedIndividual, :EVChargingSpace, :ParkingSpace .
:s_e3 a owl:NamedIndividual, :ParkingSpace .
:s_v1 a owl:NamedIndividual, :ParkingSpace .
:sara a owl:NamedIndividual, :BadgeHolder, :Student .
:usman a owl:NamedIndividual, :NonBadgeHolder, :Student .
:vp_bilal a owl:NamedIndividual, :ParkingPermit, :VisitorPass .
:zara a owl:NamedIndividual, :NonBadgeHolder, :Student .
:zone_a a owl:NamedIndividual, :ParkingZone .
:zone_e a owl:NamedIndividual, :ParkingZone .
:zone_v a owl:NamedIndividual, :ParkingZone .
:r1 :forSpace :s_a5 .
:r2 :forSpace :s_e3 .
:ahmed :hasPermit :p_ahmed .
:ali :hasPermit :p_ali .
:bilal :hasPermit :vp_bilal .
:fatima :hasPermit :p_fatima .
:sara :hasPermit :p_sara .
:usman :hasPermit :p_usman .
:zara :hasPermit :p_zara .
:s_a1 :locatedIn :zone_a .
:s_a2 :locatedIn :zone_a .
:s_a3 :locatedIn :zone_a .
:s_a4 :locatedIn :zone_a .
:s_a5 :locatedIn :zone_a .
:s_e1 :locatedIn :zone_e .
:s_e2 :locatedIn :zone_e .
:s_e3 :locatedIn :zone_e .
:s_v1 :locatedIn :zone_v .
:r1 :madeBy :zara .
:r2 :madeBy :ahmed .
:ahmed :owns :ev_ahmed .
:ali :owns :car_ali .
:bilal :owns :car_bilal .
:fatima :owns :bike_fatima .
:hina :owns :car_hina .
:sara :owns :car_sara .
:usman :owns :car_usman .
:zara :owns :car_zara .
:zone_a :partOf :ned_lot .
:zone_e :partOf :ned_lot .
:zone_v :partOf :ned_lot .
[ a owl:AllDifferent ; owl:distinctMembers ( :ahmed :ali :bike_fatima :bilal :car_ali :car_bilal :car_hina :car_sara :car_usman :car_zara :ev_ahmed :fatima :hina :ned_lot :p_ahmed :p_ali :p_fatima :p_sara :p_usman :p_zara :r1 :r2 :s_a1 :s_a2 :s_a3 :s_a4 :s_a5 :s_e1 :s_e2 :s_e3 :s_v1 :sara :usman :vp_bilal :zara :zone_a :zone_e :zone_v ) ] .
